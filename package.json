{
  "name": "wa-outreach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 7070",
    "build": "next build",
    "start": "next start -p 7070",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node lib/parse.ts && node lib/cache.ts && node lib/safety.ts && node lib/http.ts && node tests/store.ts",
    "db:up": "docker compose up -d",
    "db:reset": "docker compose down -v && docker compose up -d",
    "test:flow": "WA_DRY_RUN=1 DATABASE_URL=postgres://postgres:wa@localhost:5439/wa_test node tests/flow.ts",
    "seed": "node scripts/seed.ts",
    "bench": "node scripts/bench.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/openai": "^4.0.42",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "ai": "^7.0.66",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "shadcn": "^4.18.0",
    "socks-proxy-agent": "^10.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module",
  "description": "WhatsApp cold outreach infrastructure: bulk lists, sequences, number rotation, warmup and reply detection.",
  "license": "MIT"
}
